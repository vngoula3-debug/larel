{
  "log": {
    "loglevel": "warning"
  },
  
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": "env:PORT",
      "protocol": "vless",
      
      "settings": {
        "clients": [
          {
            "id": "@larel237",
            "flow": ""
          }
        ],
        "decryption": "none"
      },
      
      "streamSettings": {
        "network": "ws",
        "security": "none",
        
        "wsSettings": {
          "path": "/@larel237/moi",
          "heartbeatPeriod": 20
        }
      },

      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "metadataOnly": false,
        "routeOnly": false
      }
    }
  ],
  
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP"
      }
    }
  ]
}
