{
  "log": {
    "loglevel": "warning"
  },
  
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": "env:PORT",
      "protocol": "vless",
      
      "settings": {
        "clients": [
          {
            "id": "@larel237"
          }
        ],
        "decryption": "none"
      },
      
      "streamSettings": {
        "network": "ws",
        "security": "none",
        
        "wsSettings": {
          "path": "/@larel237/moi",
          "heartbeatPeriod": 20
        }
      }
    }
  ],
  
  "outbounds": [
    {
      "protocol": "freedom"
    }
  ]
}
